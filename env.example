# ── Gemini API Keys ──────────────────────────────────────────────────────────
# Get free keys from https://aistudio.google.com/app/apikey
# Add as many keys as you have (GEMINI_KEY_1, GEMINI_KEY_2, etc.)
GEMINI_KEY_1=AIza...
GEMINI_KEY_2=AIza...
GEMINI_KEY_3=AIza...

# ── Gemini Flux Settings ──────────────────────────────────────────────────────
GEMINI_MODE=both
GEMINI_LOG=true

# ── Service URLs (don't change for local Docker setup) ────────────────────────
GEMINI_FLUX_URL=http://gemini_flux:8000
